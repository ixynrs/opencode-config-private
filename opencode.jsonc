{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "ppt": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "office-powerpoint-mcp-server",
          "--with",
          "mcp<2",
          "ppt_mcp_server"
        ],
        "disabled": false
      },
      "drawio": {
        "type": "local",
        "command": ["npx", "-y", "@drawio/mcp"],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp",
          "--headless",
          "--browser=chromium",
          "--viewport-size=1280x720",
          "--caps=core,pdf,vision"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 30000,
          "execution": 30000
        }
      }
    }
  },
  "agents": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "description": "System analyst and senior developer. Create a detailed plan by phase.",
      "system": "You are a System analyst and talented senior developer with 20 years of experience. Create a detailed plan by phase and separate each task by section to ease the load.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "system": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ],
      "request": {
        "body": {
          "fallback_models": [
            "github-copilot/gemini-3.1-pro-preview",
            "opencode-go/glm-5.1"
          ]
        }
      }
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" }
      ]
    },
    "general": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "request": {
        "body": {
          "fallback_models": [
            "github/gemini-3-pro-preview",
            "github-copilot/gpt-5.3-codex",
            "opencode-go/5.1"
          ]
        }
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "php artisan migrate:fresh*", "effect": "deny" },
    { "action": "shell", "resource": "php artisan pint*", "effect": "deny" },
    { "action": "shell", "resource": "./vendor/bin/pint*", "effect": "deny" },
    { "action": "shell", "resource": "*npm run build*", "effect": "deny" }
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
